<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nexus.App.Controls.AlienPermissionSelector"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PermissionFlyoutStyle" TargetType="FlyoutPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style x:Key="PermissionCellStyle" TargetType="Button">
            <Setter Property="Width" Value="260" /><Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="0" /><Setter Property="Padding" Value="14,0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="#B80B1720" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#E4EFF8FA" /><Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" />
            <Setter Property="FontSize" Value="9" /><Setter Property="CharacterSpacing" Value="35" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid x:Name="PermissionCell" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><CompositeTransform x:Name="PermissionCellTransform" /></Grid.RenderTransform>
                    <Path x:Name="CellAura" Data="M 0,0 L 244,0 L 260,13 L 260,38 L 12,38 L 0,27 Z"
                          Stretch="Fill" Fill="#3200E5D0" Margin="-3" Opacity="0" />
                    <Path Data="M 0,0 L 244,0 L 260,13 L 260,38 L 12,38 L 0,27 Z"
                          Stretch="Fill" Fill="{TemplateBinding Background}" />
                    <Path x:Name="CellTrace" Data="M 0,27 L 0,0 L 55,0 M 218,0 L 244,0 L 260,13 L 260,25 M 260,38 L 12,38"
                          Stretch="Fill" Stroke="#6200E5FF" StrokeThickness="1" />
                    <Rectangle x:Name="CellBeam" Width="26" Height="2" Fill="#9E00E5FF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,-1,0,0" Opacity="0.35" />
                    <ContentPresenter Margin="17,0,32,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    <Grid HorizontalAlignment="Right" Margin="0,0,10,0" Width="14" Height="14">
                        <Path Data="M 7,1 L 13,7 L 7,13 L 1,7 Z" Stroke="#7800E5FF" StrokeThickness="1" />
                        <Ellipse x:Name="CellNode" Width="3" Height="3" Fill="#FF00E5FF" Opacity="0.3" />
                    </Grid>
                    <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                        <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.17" /></VisualStateGroup.Transitions>
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver"><VisualState.Setters>
                            <Setter Target="CellAura.Opacity" Value="1" /><Setter Target="CellTrace.Opacity" Value="1" />
                            <Setter Target="CellBeam.Opacity" Value="1" /><Setter Target="CellNode.Opacity" Value="1" />
                            <Setter Target="PermissionCellTransform.TranslateX" Value="4" />
                        </VisualState.Setters></VisualState>
                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="PermissionCellTransform.ScaleX" Value="0.98" /><Setter Target="PermissionCellTransform.ScaleY" Value="0.98" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="PermissionCell.Opacity" Value="0.3" /></VisualState.Setters></VisualState>
                    </VisualStateGroup></VisualStateManager.VisualStateGroups>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>

    <Grid Width="286" MinHeight="64" HorizontalAlignment="Left">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="42" /></Grid.RowDefinitions>
        <TextBlock Text="{Binding Header, ElementName=Root}" FontFamily="{StaticResource OrbitronFont}"
                   FontSize="9.5" CharacterSpacing="35" Foreground="#E8F4FAFC" Margin="0,0,0,5" />
        <Button x:Name="SelectorTrigger" Grid.Row="1" Width="286" Height="42" MinWidth="0" Padding="0"
                AutomationProperties.Name="Permission mode selector"
                HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False">
            <Button.Template><ControlTemplate TargetType="Button">
                <Grid x:Name="SelectorShell" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><CompositeTransform x:Name="SelectorTransform" /></Grid.RenderTransform>
                    <Path x:Name="SelectorAura" Data="M 0,0 L 264,0 L 286,16 L 286,42 L 14,42 L 0,28 Z"
                          Stretch="Fill" Fill="#2600E5D0" Margin="-3" Opacity="0" />
                    <Path Data="M 0,0 L 264,0 L 286,16 L 286,42 L 14,42 L 0,28 Z"
                          Stretch="Fill" Fill="#B6111C25" />
                    <Path x:Name="SelectorTrace" Data="M 0,28 L 0,0 L 72,0 M 232,0 L 264,0 L 286,16 L 286,29 M 286,42 L 14,42 L 6,34"
                          Stretch="Fill" Stroke="#9200E5FF" StrokeThickness="1" />
                    <Rectangle Width="34" Height="2" Fill="#C000E5FF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,-1,0,0" />
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                        <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.18" /></VisualStateGroup.Transitions>
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="SelectorAura.Opacity" Value="1" /><Setter Target="SelectorTrace.Opacity" Value="1" /><Setter Target="SelectorTransform.ScaleX" Value="1.015" /><Setter Target="SelectorTransform.ScaleY" Value="1.015" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="SelectorTransform.ScaleX" Value="0.985" /><Setter Target="SelectorTransform.ScaleY" Value="0.985" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="SelectorShell.Opacity" Value="0.3" /></VisualState.Setters></VisualState>
                    </VisualStateGroup></VisualStateManager.VisualStateGroups>
                </Grid>
            </ControlTemplate></Button.Template>
            <Grid Margin="16,0,12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                <Grid Width="18" Height="18" VerticalAlignment="Center">
                    <Path Data="M 9,1 L 17,9 L 9,17 L 1,9 Z" Stroke="#A800E5FF" StrokeThickness="1.1" />
                    <Ellipse Width="4" Height="4" Fill="#EA00E5FF" />
                </Grid>
                <TextBlock x:Name="SelectionText" Grid.Column="1" VerticalAlignment="Center"
                           FontFamily="{StaticResource OrbitronFont}" FontSize="9.5" CharacterSpacing="30" Foreground="#F0F7FCFF" />
                <Grid Grid.Column="2" Width="22" Height="22" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><CompositeTransform x:Name="ChevronTransform" /></Grid.RenderTransform>
                    <Path Data="M 4,7 L 11,14 L 18,7" Stroke="#D000E5FF" StrokeThickness="1.3" />
                    <Line X1="6" Y1="18" X2="16" Y2="18" Stroke="#5200E5FF" StrokeThickness="1" />
                </Grid>
            </Grid>
            <Button.Flyout>
                <Flyout x:Name="PermissionFlyout" Placement="BottomEdgeAlignedLeft"
                        FlyoutPresenterStyle="{StaticResource PermissionFlyoutStyle}"
                        Opening="PermissionFlyout_Opening" Closed="PermissionFlyout_Closed">
                    <Grid Width="286" Padding="10,13,16,16">
                        <Path Data="M 0,14 L 14,0 L 250,0 L 286,30 L 286,166 L 270,182 L 18,182 L 0,164 Z"
                              Stretch="Fill" Fill="#F0050C12" />
                        <Path Data="M 0,58 L 0,14 L 14,0 L 92,0 M 187,0 L 250,0 L 286,30 L 286,73 M 286,139 L 286,166 L 270,182 L 194,182 M 95,182 L 18,182 L 0,164"
                              Stretch="Fill" Stroke="#9C00E5FF" StrokeThickness="1.1" />
                        <Path Data="M 8,32 L 8,18 L 20,7 L 48,7 M 237,174 L 263,174 L 278,159"
                              Stretch="Fill" Stroke="#4300E5FF" StrokeThickness="1" />
                        <StackPanel Spacing="3" Margin="4,5,0,0">
                            <Button x:Name="ObserveOption" Style="{StaticResource PermissionCellStyle}" Content="OBSERVE // PASSIVE SENSOR" Tag="0" Click="Option_Click" />
                            <Button x:Name="SuggestOption" Style="{StaticResource PermissionCellStyle}" Content="SUGGEST // ADVISORY MODE" Tag="1" Click="Option_Click" />
                            <Button x:Name="ConfirmOption" Style="{StaticResource PermissionCellStyle}" Content="CONFIRM // HUMAN GATE" Tag="2" Click="Option_Click" />
                            <Button x:Name="TrustedOption" Style="{StaticResource PermissionCellStyle}" Content="TRUSTED // ROUTINE LINK" Tag="3" Click="Option_Click" />
                        </StackPanel>
                        <Ellipse Width="5" Height="5" Fill="#E600E5FF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,9,0" />
                    </Grid>
                </Flyout>
            </Button.Flyout>
        </Button>
    </Grid>
</UserControl>
