<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nexus.App.Controls.MeshBrainControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">
    <UserControl.Resources>
        <Storyboard x:Name="SearchResultsRevealStoryboard">
            <DoubleAnimation Storyboard.TargetName="SearchResultsPanel" Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.22" />
            <DoubleAnimation Storyboard.TargetName="SearchResultsTransform" Storyboard.TargetProperty="TranslateY"
                             To="0" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SearchResultsTransform" Storyboard.TargetProperty="ScaleY"
                             To="1" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="SearchResultsHideStoryboard">
            <DoubleAnimation Storyboard.TargetName="SearchResultsPanel" Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.16" />
            <DoubleAnimation Storyboard.TargetName="SearchResultsTransform" Storyboard.TargetProperty="TranslateY"
                             To="28" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SearchResultsTransform" Storyboard.TargetProperty="ScaleY"
                             To="0.94" Duration="0:0:0.18" />
        </Storyboard>
        <Storyboard x:Name="SearchDockExpandStoryboard">
            <DoubleAnimation Storyboard.TargetName="MeshSearchDock" Storyboard.TargetProperty="Width"
                             To="366" Duration="0:0:0.28" EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MeshSearchInputLayer" Storyboard.TargetProperty="Opacity"
                             To="1" BeginTime="0:0:0.10" Duration="0:0:0.20" />
        </Storyboard>
        <Storyboard x:Name="SearchDockCollapseStoryboard">
            <DoubleAnimation Storyboard.TargetName="MeshSearchInputLayer" Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.10" />
            <DoubleAnimation Storyboard.TargetName="MeshSearchDock" Storyboard.TargetProperty="Width"
                             To="54" BeginTime="0:0:0.06" Duration="0:0:0.24" EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="MeshSettingsShowStoryboard">
            <DoubleAnimation Storyboard.TargetName="MeshVisibilityPanel" Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.20" />
            <DoubleAnimation Storyboard.TargetName="MeshSettingsTransform" Storyboard.TargetProperty="TranslateX"
                             To="0" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MeshSettingsTransform" Storyboard.TargetProperty="ScaleX"
                             To="1" Duration="0:0:0.24" />
            <DoubleAnimation Storyboard.TargetName="MeshSettingsTransform" Storyboard.TargetProperty="ScaleY"
                             To="1" Duration="0:0:0.24" />
        </Storyboard>
        <Storyboard x:Name="MeshSettingsHideStoryboard">
            <DoubleAnimation Storyboard.TargetName="MeshVisibilityPanel" Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.14" />
            <DoubleAnimation Storyboard.TargetName="MeshSettingsTransform" Storyboard.TargetProperty="TranslateX"
                             To="18" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MeshSettingsTransform" Storyboard.TargetProperty="ScaleX"
                             To="0.96" Duration="0:0:0.18" />
            <DoubleAnimation Storyboard.TargetName="MeshSettingsTransform" Storyboard.TargetProperty="ScaleY"
                             To="0.96" Duration="0:0:0.18" />
        </Storyboard>
        <Storyboard x:Name="AlienIconPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="AlienIconAura" Storyboard.TargetProperty="Opacity"
                             From="0.18" To="0.72" Duration="0:0:1.15" />
            <DoubleAnimation Storyboard.TargetName="AlienIconTransform" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.07" Duration="0:0:1.15" />
            <DoubleAnimation Storyboard.TargetName="AlienIconTransform" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.07" Duration="0:0:1.15" />
        </Storyboard>

        <Style x:Key="MeshSearchResultButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="49" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ResultCell" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><CompositeTransform x:Name="ResultTransform" /></Grid.RenderTransform>
                            <Path x:Name="ResultAura" Data="M 0,8 L 8,0 L 332,0 L 348,13 L 348,41 L 340,49 L 14,49 L 0,35 Z"
                                  Stretch="Fill" Fill="#3400E5FF" Opacity="0" Margin="-3" />
                            <Path Data="M 0,8 L 8,0 L 332,0 L 348,13 L 348,41 L 340,49 L 14,49 L 0,35 Z"
                                  Stretch="Fill" Fill="#C20A1115" />
                            <Path x:Name="ResultTrace" Data="M 0,35 L 0,8 L 8,0 L 78,0 M 259,0 L 332,0 L 348,13 L 348,24 M 348,41 L 340,49 L 278,49 M 86,49 L 14,49 L 5,40"
                                  Stretch="Fill" Stroke="#6500E5FF" StrokeThickness="1" />
                            <Rectangle x:Name="ResultSignal" Width="2" Height="25" Fill="#B900E5FF"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <ContentPresenter Margin="15,0,13,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.15" /></VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver"><VisualState.Setters>
                                        <Setter Target="ResultAura.Opacity" Value="1" />
                                        <Setter Target="ResultTrace.Stroke" Value="#E600F4FF" />
                                        <Setter Target="ResultSignal.Opacity" Value="1" />
                                        <Setter Target="ResultTransform.ScaleX" Value="1.018" />
                                        <Setter Target="ResultTransform.ScaleY" Value="1.018" />
                                    </VisualState.Setters></VisualState>
                                    <VisualState x:Name="Pressed"><VisualState.Setters>
                                        <Setter Target="ResultTransform.ScaleX" Value="0.985" />
                                        <Setter Target="ResultTransform.ScaleY" Value="0.985" />
                                    </VisualState.Setters></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NodeLaunchIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="31" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="LaunchCell" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><CompositeTransform x:Name="LaunchTransform" /></Grid.RenderTransform>
                            <Path x:Name="LaunchAura" Data="M 0,7 L 7,0 L 25,0 L 31,6 L 31,22 L 25,28 L 6,28 L 0,22 Z"
                                  Stretch="Fill" Fill="#3DFFB020" Margin="-3" Opacity="0" />
                            <Path Data="M 0,7 L 7,0 L 25,0 L 31,6 L 31,22 L 25,28 L 6,28 L 0,22 Z"
                                  Stretch="Fill" Fill="#D6081415" Stroke="#96FFB020" StrokeThickness="1" />
                            <Path Data="M 3,18 L 3,9 L 8,4 M 23,2 L 27,6 L 27,11 M 27,20 L 23,25 L 16,25"
                                  Stretch="Fill" Stroke="#62FFB020" StrokeThickness="1" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.14" /></VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver"><VisualState.Setters>
                                        <Setter Target="LaunchAura.Opacity" Value="1" />
                                        <Setter Target="LaunchTransform.ScaleX" Value="1.09" />
                                        <Setter Target="LaunchTransform.ScaleY" Value="1.09" />
                                    </VisualState.Setters></VisualState>
                                    <VisualState x:Name="Pressed"><VisualState.Setters>
                                        <Setter Target="LaunchTransform.ScaleX" Value="0.92" />
                                        <Setter Target="LaunchTransform.ScaleY" Value="0.92" />
                                    </VisualState.Setters></VisualState>
                                    <VisualState x:Name="Disabled"><VisualState.Setters>
                                        <Setter Target="LaunchCell.Opacity" Value="0.25" />
                                    </VisualState.Setters></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NodeInspectorTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Background" Value="#18FFB020" />
            <Setter Property="Foreground" Value="#E9DFFFEA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" />
            <Setter Property="FontSize" Value="6.5" />
            <Setter Property="CharacterSpacing" Value="95" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="InspectorTab" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><CompositeTransform x:Name="InspectorTabTransform" /></Grid.RenderTransform>
                            <Path Data="M 0,7 L 7,0 L 86,0 L 96,10 L 96,24 L 90,30 L 8,30 L 0,22 Z"
                                  Stretch="Fill" Fill="{TemplateBinding Background}" Stroke="#78FFB020" StrokeThickness="1" />
                            <Rectangle Width="22" Height="2" Fill="#C9FFB020" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,-1,0,0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.14" /></VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver"><VisualState.Setters>
                                    <Setter Target="InspectorTabTransform.ScaleX" Value="1.04" />
                                    <Setter Target="InspectorTabTransform.ScaleY" Value="1.04" />
                                </VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters>
                                    <Setter Target="InspectorTabTransform.ScaleX" Value="0.96" />
                                    <Setter Target="InspectorTabTransform.ScaleY" Value="0.96" />
                                </VisualState.Setters></VisualState>
                            </VisualStateGroup></VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="InteractionSurface" MinWidth="360" MinHeight="360" Background="#01000000">
        <canvas:CanvasAnimatedControl x:Name="MeshCanvas" Draw="MeshCanvas_Draw"
                                      CreateResources="MeshCanvas_CreateResources" ClearColor="Transparent"
                                      IsTabStop="True" KeyDown="MeshCanvas_KeyDown" />

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,22,0"
                    Spacing="8" Canvas.ZIndex="35">
            <Button x:Name="MeshVisibilityButton" Width="52" Height="52" MinWidth="0" MinHeight="0"
                    Padding="0" HorizontalAlignment="Right" Background="#E2081013"
                    BorderBrush="#A700E5FF" BorderThickness="1" Click="MeshVisibilityButton_Click"
                    AutomationProperties.Name="Open mesh settings">
                <Grid Width="38" Height="38" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><CompositeTransform x:Name="AlienIconTransform" /></Grid.RenderTransform>
                    <Ellipse x:Name="AlienIconAura" Width="36" Height="36" Fill="#3000E5FF"
                             Stroke="#7500E5FF" StrokeThickness="1" />
                    <Path Data="M 19,4 C 11,4 6,10 7,18 C 8,26 13,32 19,34 C 25,32 30,26 31,18 C 32,10 27,4 19,4 Z"
                          Fill="#2812D6E8" Stroke="#E000E5FF" StrokeThickness="1.3" />
                    <Path Data="M 10,18 C 13,13 16,13 18,19 C 15,23 12,22 10,18 Z"
                          Fill="#EE9BFFF8" />
                    <Path Data="M 28,18 C 25,13 22,13 20,19 C 23,23 26,22 28,18 Z"
                          Fill="#EE9BFFF8" />
                    <Ellipse Width="2.4" Height="2.4" Fill="#FFFFFFFF" Margin="-10,0,0,0" />
                    <Ellipse Width="2.4" Height="2.4" Fill="#FFFFFFFF" Margin="10,0,0,0" />
                    <Path Data="M 15,28 C 17,29 21,29 23,28" Stroke="#A500E5FF" StrokeThickness="1" />
                    <Path Data="M 1,12 L 1,3 L 10,3 M 28,35 L 35,35 L 35,27"
                          Stroke="#A7FFB020" StrokeThickness="1" />
                </Grid>
            </Button>

            <Grid x:Name="MeshVisibilityPanel" Width="330" Height="720" Visibility="Collapsed"
                  Opacity="0" RenderTransformOrigin="1,0">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="MeshSettingsTransform" TranslateX="18" ScaleX="0.96" ScaleY="0.96" />
                </Grid.RenderTransform>
                <Path Data="M 0,18 L 18,0 L 294,0 L 330,30 L 330,700 L 308,720 L 16,720 L 0,702 Z"
                      Stretch="Fill" Fill="#F0080D0E" Stroke="#98FFB020" StrokeThickness="1" />
                <Rectangle Width="62" Height="2" Fill="#E8FFB020" HorizontalAlignment="Left"
                           VerticalAlignment="Top" Margin="24,-1,0,0" />
                <ScrollViewer Margin="20,17,18,16" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="MESH SETTINGS // COGNITION FORM" FontFamily="{StaticResource OrbitronFont}"
                                       FontSize="8" CharacterSpacing="90" Foreground="#F000E5FF" />
                            <TextBlock Text="ORBIT / NODES / SIGNAL / DRIVE CHROMA" FontFamily="{StaticResource OrbitronFont}"
                                       FontSize="6" CharacterSpacing="40" Foreground="#879FD5DB" />
                        </StackPanel>
                        <TextBlock Text="Ξ" HorizontalAlignment="Right" FontSize="18" Foreground="#9700E5FF" />
                    </Grid>
                    <Rectangle Height="1" Fill="#4900E5FF" Margin="0,2,0,2" />
                    <TextBlock Text="MESH ORBIT // SAVED" FontFamily="{StaticResource OrbitronFont}"
                               FontSize="8" CharacterSpacing="105" Foreground="#F0FFB020" />
                    <CheckBox x:Name="AutoOrbitCheckBox" Content="AUTO ROTATION" IsChecked="True"
                              FontFamily="{StaticResource OrbitronFont}" FontSize="8" Foreground="#DFFFD170"
                              Click="OrbitSetting_Changed" />
                    <CheckBox x:Name="ReverseOrbitCheckBox" Content="REVERSE DIRECTION" IsChecked="False"
                              FontFamily="{StaticResource OrbitronFont}" FontSize="8" Foreground="#DFFFD170"
                              Click="OrbitSetting_Changed" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="ROTATION SPEED" FontFamily="{StaticResource OrbitronFont}"
                                   FontSize="7" Foreground="#B8FFD170" />
                        <TextBlock x:Name="OrbitSpeedValueText" Grid.Column="1" Text="100%"
                                   FontFamily="{StaticResource OrbitronFont}" FontSize="7" Foreground="#D000E5FF" />
                    </Grid>
                    <Slider x:Name="OrbitSpeedSlider" Minimum="0" Maximum="300" Value="100"
                            StepFrequency="5" ValueChanged="OrbitSetting_ValueChanged" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="STARTING PHASE" FontFamily="{StaticResource OrbitronFont}"
                                   FontSize="7" Foreground="#B8FFD170" />
                        <TextBlock x:Name="OrbitPhaseValueText" Grid.Column="1" Text="0°"
                                   FontFamily="{StaticResource OrbitronFont}" FontSize="7" Foreground="#D000E5FF" />
                    </Grid>
                    <Slider x:Name="OrbitPhaseSlider" Minimum="0" Maximum="360" Value="0"
                            StepFrequency="5" ValueChanged="OrbitSetting_ValueChanged" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="CAMERA TILT" FontFamily="{StaticResource OrbitronFont}"
                                   FontSize="7" Foreground="#B8FFD170" />
                        <TextBlock x:Name="OrbitTiltValueText" Grid.Column="1" Text="10°"
                                   FontFamily="{StaticResource OrbitronFont}" FontSize="7" Foreground="#D000E5FF" />
                    </Grid>
                    <Slider x:Name="OrbitTiltSlider" Minimum="-45" Maximum="45" Value="10"
                            StepFrequency="1" ValueChanged="OrbitSetting_ValueChanged" />
                    <TextBlock Text="DRAG TO INSPECT / DOUBLE TAP RETURNS TO SAVED PHASE"
                               FontFamily="{StaticResource OrbitronFont}" FontSize="6" CharacterSpacing="24"
                               Foreground="#7388A3A8" />
                    <Rectangle Height="1" Fill="#43FFB020" Margin="0,3,0,2" />
                    <TextBlock Text="MESH VISIBILITY // LIVE" FontFamily="{StaticResource OrbitronFont}"
                               FontSize="8" CharacterSpacing="105" Foreground="#F0FFB020" />
                    <TextBlock x:Name="MeshVisibilitySummaryText" Text="6 LAYERS // FILE PARTICLES ON"
                               FontFamily="{StaticResource OrbitronFont}" FontSize="7" CharacterSpacing="45"
                               Foreground="#94BBC4B8" />
                    <TextBlock Text="FILE = SOLID DOT  /  DIRECTORY = HOLLOW RING"
                               FontFamily="{StaticResource OrbitronFont}" FontSize="6" CharacterSpacing="25"
                               Foreground="#83FFD170" />
                    <Rectangle Height="1" Fill="#43FFB020" Margin="0,2,0,2" />

                    <CheckBox Content="DRIVE ROOTS" IsChecked="True" IsEnabled="False"
                              FontFamily="{StaticResource OrbitronFont}" FontSize="8" Foreground="#DFFFD170" />
                    <CheckBox x:Name="ShowMajorDirectoriesCheckBox" Content="MAJOR DIRECTORIES" IsChecked="True"
                              FontFamily="{StaticResource OrbitronFont}" FontSize="8" Foreground="#DFFFD170"
                              Click="MeshVisibilityOption_Click" />
                    <CheckBox x:Name="ShowDeepDirectoriesCheckBox" Content="DEEP DIRECTORY DETAIL" IsChecked="True"
                              FontFamily="{StaticResource OrbitronFont}" FontSize="8" Foreground="#DFFFD170"
                              Click="MeshVisibilityOption_Click" />
                    <CheckBox x:Name="ShowAggregateNodesCheckBox" Content="AGGREGATED FILE GROUPS" IsChecked="True"
                              FontFamily="{StaticResource OrbitronFont}" FontSize="8" Foreground="#DFFFD170"
                              Click="MeshVisibilityOption_Click" />
                    <CheckBox x:Name="ShowIndividualFilesCheckBox" Content="INDIVIDUAL FILES" IsChecked="True"
                              FontFamily="{StaticResource OrbitronFont}" FontSize="8" Foreground="#DFFFD170"
                              Click="MeshVisibilityOption_Click" />
                    <CheckBox x:Name="ShowSystemNodesCheckBox" Content="SYSTEM / HIDDEN CONTENT" IsChecked="False"
                              FontFamily="{StaticResource OrbitronFont}" FontSize="8" Foreground="#DFFFD170"
                              Click="MeshVisibilityOption_Click" />
                    <CheckBox x:Name="ShowActiveOperationsCheckBox" Content="LIVE FILE OPERATIONS" IsChecked="True"
                              FontFamily="{StaticResource OrbitronFont}" FontSize="8" Foreground="#DFFFD170"
                              Click="MeshVisibilityOption_Click" />
                    <CheckBox x:Name="ShowDirectoryConnectionsCheckBox" Content="DIRECTORY CONNECTIONS" IsChecked="True"
                              FontFamily="{StaticResource OrbitronFont}" FontSize="8" Foreground="#DFFFD170"
                              Click="MeshVisibilityOption_Click" />

                    <Rectangle Height="1" Fill="#43FFB020" Margin="0,5,0,2" />
                    <TextBlock Text="MESH APPEARANCE // SAVED" FontFamily="{StaticResource OrbitronFont}"
                               FontSize="8" CharacterSpacing="85" Foreground="#F0FFB020" />
                    <TextBlock Text="GENERAL NODE SIZE" FontFamily="{StaticResource OrbitronFont}"
                               FontSize="7" Foreground="#B8FFD170" />
                    <Slider x:Name="GeneralNodeScaleSlider" Minimum="25" Maximum="250" Value="100"
                            StepFrequency="5" ValueChanged="MeshAppearance_ValueChanged" />
                    <TextBlock Text="FILE DOT SIZE" FontFamily="{StaticResource OrbitronFont}"
                               FontSize="7" Foreground="#B8FFD170" />
                    <Slider x:Name="FileNodeScaleSlider" Minimum="25" Maximum="250" Value="100"
                            StepFrequency="5" ValueChanged="MeshAppearance_ValueChanged" />
                    <TextBlock Text="DIRECTORY RING SIZE" FontFamily="{StaticResource OrbitronFont}"
                               FontSize="7" Foreground="#B8FFD170" />
                    <Slider x:Name="DirectoryNodeScaleSlider" Minimum="25" Maximum="250" Value="100"
                            StepFrequency="5" ValueChanged="MeshAppearance_ValueChanged" />
                    <TextBlock Text="DATA TRANSFER STYLE" FontFamily="{StaticResource OrbitronFont}"
                               FontSize="7" Foreground="#B8FFD170" />
                    <ComboBox x:Name="TransferStyleComboBox" SelectedIndex="1" HorizontalAlignment="Stretch"
                              FontFamily="{StaticResource OrbitronFont}" FontSize="7"
                              SelectionChanged="TransferStyleComboBox_SelectionChanged">
                        <ComboBoxItem Content="TRAVELLING NEURONS" Tag="Travel" />
                        <ComboBoxItem Content="NODE GLOW ONLY (NO ACTIVITY LINES)" Tag="Glow" />
                    </ComboBox>
                    <CheckBox x:Name="ColorCodeByDriveCheckBox" Content="COLOR CODE BY DRIVE" IsChecked="True"
                              FontFamily="{StaticResource OrbitronFont}" FontSize="8" Foreground="#DFFFD170"
                              Click="MeshVisibilityOption_Click" />

                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="DIRECTORY" FontSize="7" Foreground="#B8FFD170"/>
                            <TextBox x:Name="DirectoryColorTextBox" Text="#5C96FF" FontSize="8"/>
                            <Button Content="PICK COLOR" Tag="Directory" Height="24" FontSize="7"
                                    Click="MeshColorPicker_Click" />
                            <TextBlock Text="FILE" FontSize="7" Foreground="#B8FFD170"/>
                            <TextBox x:Name="FileColorTextBox" Text="#3DDAFF" FontSize="8"/>
                            <Button Content="PICK COLOR" Tag="File" Height="24" FontSize="7"
                                    Click="MeshColorPicker_Click" />
                            <TextBlock Text="SELECTION" FontSize="7" Foreground="#B8FFD170"/>
                            <TextBox x:Name="SelectionColorTextBox" Text="#36FF89" FontSize="8"/>
                            <Button Content="PICK COLOR" Tag="Selection" Height="24" FontSize="7"
                                    Click="MeshColorPicker_Click" />
                            <TextBlock Text="ACCESS / READ" FontSize="7" Foreground="#B8FFD170"/>
                            <TextBox x:Name="AccessColorTextBox" Text="#00E5FF" FontSize="8"/>
                            <Button Content="PICK COLOR" Tag="Access" Height="24" FontSize="7"
                                    Click="MeshColorPicker_Click" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="WRITE / MODIFY" FontSize="7" Foreground="#B8FFD170"/>
                            <TextBox x:Name="WriteColorTextBox" Text="#FFB020" FontSize="8"/>
                            <Button Content="PICK COLOR" Tag="Write" Height="24" FontSize="7"
                                    Click="MeshColorPicker_Click" />
                            <TextBlock Text="CREATE / COPY" FontSize="7" Foreground="#B8FFD170"/>
                            <TextBox x:Name="CreateColorTextBox" Text="#40EE87" FontSize="8"/>
                            <Button Content="PICK COLOR" Tag="Create" Height="24" FontSize="7"
                                    Click="MeshColorPicker_Click" />
                            <TextBlock Text="MOVE / TRANSFER" FontSize="7" Foreground="#B8FFD170"/>
                            <TextBox x:Name="MoveColorTextBox" Text="#B65CFF" FontSize="8"/>
                            <Button Content="PICK COLOR" Tag="Move" Height="24" FontSize="7"
                                    Click="MeshColorPicker_Click" />
                            <TextBlock Text="DELETE" FontSize="7" Foreground="#B8FFD170"/>
                            <TextBox x:Name="DeleteColorTextBox" Text="#FF303A" FontSize="8"/>
                            <Button Content="PICK COLOR" Tag="Delete" Height="24" FontSize="7"
                                    Click="MeshColorPicker_Click" />
                        </StackPanel>
                    </Grid>
