<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nexus.App.Controls.NeuralCoreControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">
    <Grid x:Name="InteractionSurface" MinWidth="360" MinHeight="360" Background="Transparent"
          SizeChanged="InteractionSurface_SizeChanged"
          Tapped="InteractionSurface_Tapped"
          PointerPressed="InteractionSurface_PointerPressed"
          PointerMoved="InteractionSurface_PointerMoved"
          PointerReleased="InteractionSurface_PointerReleased"
          PointerCanceled="InteractionSurface_PointerCanceled"
          PointerCaptureLost="InteractionSurface_PointerCaptureLost"
          AutomationProperties.Name="System health and safe optimization controls"
          AutomationProperties.HelpText="Drag the holographic portrait horizontally to rotate it.">
        <canvas:CanvasAnimatedControl x:Name="HudCanvas" Draw="HudCanvas_Draw" ClearColor="Transparent" />
        <Canvas x:Name="PortraitLayer" IsHitTestVisible="True">
            <WebView2 x:Name="PortraitWebView" Width="200" Height="250" Visibility="Collapsed"
                      DefaultBackgroundColor="#FF000000" IsTabStop="False"
                      AutomationProperties.Name="Rotatable 3D portrait"
                      AutomationProperties.HelpText="Drag horizontally to rotate; use the mouse wheel to zoom." />
        </Canvas>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2" IsHitTestVisible="False">
            <TextBlock x:Name="CoreMetricText" Text="--" FontFamily="{StaticResource OrbitronFont}" FontSize="31" FontWeight="SemiBold" Foreground="#FFF4FCFF" HorizontalAlignment="Center" />
            <TextBlock x:Name="StateText" Text="INITIALIZING" FontSize="10" FontWeight="SemiBold" CharacterSpacing="155" Foreground="#F4FFFFFF" HorizontalAlignment="Center" />
            <TextBlock Text="HEALTH / 100" FontSize="7" CharacterSpacing="125" Foreground="#A078909C" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
