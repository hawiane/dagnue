<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nexus.App.Controls.AlienDatePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Nexus.App.Controls">
    <UserControl.Resources>
        <Style x:Key="AlienCalendarFlyoutStyle" TargetType="FlyoutPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="IsDefaultShadowEnabled" Value="False" />
        </Style>
        <Style x:Key="AlienDateTriggerStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#A914202A" />
            <Setter Property="Foreground" Value="#F3F9FCFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><CompositeTransform x:Name="RootTransform" /></Grid.RenderTransform>
                            <Path Data="M 7,0 L 93,0 L 100,7 L 100,29 L 92,37 L 7,37 L 0,30 L 0,7 Z"
                                  Stretch="Fill" Fill="{TemplateBinding Background}" />
                            <Path x:Name="EdgeTrace" Data="M 0,29 L 0,8 L 8,0 L 33,0 M 78,37 L 92,37 L 100,29"
                                  Stretch="Fill" Stroke="#A500E5FF" StrokeThickness="1" Opacity="0.45" />
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="4,0" />
                            <Ellipse x:Name="Node" Width="4" Height="4" Fill="#FF00E5FF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,6,0" Opacity="0.38" />
                            <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.14" /></VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="EdgeTrace.Opacity" Value="1" /><Setter Target="Node.Opacity" Value="1" /><Setter Target="RootTransform.ScaleX" Value="1.015" /><Setter Target="RootTransform.ScaleY" Value="1.015" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="RootTransform.ScaleX" Value="0.98" /><Setter Target="RootTransform.ScaleY" Value="0.98" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.35" /></VisualState.Setters></VisualState>
                            </VisualStateGroup></VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AlienCalendarNavStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#E800E5FF" />
            <Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Cell">
                            <Path x:Name="Plate" Data="M 6,0 L 26,0 L 32,6 L 32,22 L 26,28 L 6,28 L 0,22 L 0,6 Z" Stretch="Fill" Fill="#3614202A" Stroke="#6500E5FF" StrokeThickness="1" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Plate.Fill" Value="#5A00B8CE" /><Setter Target="Plate.Stroke" Value="#F000E5FF" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Cell.Opacity" Value="0.65" /></VisualState.Setters></VisualState>
                            </VisualStateGroup></VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AlienCalendarDayStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="DayCell" Width="42" Height="38" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><CompositeTransform x:Name="DayTransform" /></Grid.RenderTransform>
                            <Path x:Name="SelectionPlate" Data="M 10,1 L 32,1 L 41,10 L 41,28 L 32,37 L 10,37 L 1,28 L 1,10 Z"
                                  Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                            <Path x:Name="HoverTrace" Data="M 1,14 L 1,8 L 8,1 L 15,1 M 27,37 L 34,37 L 41,30 L 41,24"
                                  Stroke="#E000E5FF" StrokeThickness="1" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                            <Ellipse x:Name="DayNode" Width="3" Height="3" Fill="#FF00E5FF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" Opacity="0" />
                            <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.12" /></VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="HoverTrace.Opacity" Value="1" /><Setter Target="DayNode.Opacity" Value="1" /><Setter Target="DayTransform.ScaleX" Value="1.08" /><Setter Target="DayTransform.ScaleY" Value="1.08" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="DayTransform.ScaleX" Value="0.92" /><Setter Target="DayTransform.ScaleY" Value="0.92" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="DayCell.Opacity" Value="0.3" /></VisualState.Setters></VisualState>
                            </VisualStateGroup></VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Button x:Name="DateTrigger" Style="{StaticResource AlienDateTriggerStyle}" HorizontalAlignment="Stretch"
            AutomationProperties.Name="Select reminder date">
        <Button.Flyout>
            <Flyout x:Name="CalendarFlyout" Placement="BottomEdgeAlignedLeft" FlyoutPresenterStyle="{StaticResource AlienCalendarFlyoutStyle}" Opening="CalendarFlyout_Opening">
                <Grid Width="348" Height="414">
                    <Path Data="M 17,0 L 295,0 L 315,18 L 348,18 L 348,365 L 324,389 L 324,414 L 30,414 L 0,384 L 0,26 L 17,9 Z"
                          Fill="#F2071017" />
                    <Path Data="M 0,64 L 0,26 L 18,8 L 117,8 M 231,8 L 295,8 L 315,26 L 347,26 M 347,330 L 347,365 L 323,389 L 323,405 L 246,405 M 102,405 L 30,405 L 8,383 L 8,347"
                          Stroke="#C600E5FF" StrokeThickness="1.1" />
                    <Path Data="M 17,52 L 17,25 L 31,12 M 331,52 L 331,38 L 319,26 M 18,358 L 18,379 L 34,395"
                          Stroke="#5200E5FF" StrokeThickness="1" />
                    <Canvas IsHitTestVisible="False" Opacity="0.3">
                        <Ellipse Canvas.Left="102" Canvas.Top="111" Width="144" Height="144" Stroke="#3600E5FF" StrokeThickness="1" />
                        <Ellipse Canvas.Left="122" Canvas.Top="131" Width="104" Height="104" Stroke="#2600E5FF" StrokeThickness="1" StrokeDashArray="2,8" />
                        <Line X1="28" Y1="88" X2="320" Y2="88" Stroke="#3200E5FF" StrokeThickness="1" />
                        <Rectangle Canvas.Left="9" Canvas.Top="129" Width="3" Height="54" Fill="#7800E5FF" />
                        <Rectangle Canvas.Left="336" Canvas.Top="244" Width="3" Height="38" Fill="#7800E5FF" />
                    </Canvas>

                    <Grid Margin="20,15,20,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="43" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="240" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="TEMPORAL COORDINATE // LOCAL" FontFamily="{StaticResource OrbitronFont}" FontSize="7" CharacterSpacing="115" Foreground="#AE00E5FF" />
                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,3,0,0">
                                    <Ellipse Width="4" Height="4" Fill="#FF00E5FF" VerticalAlignment="Center" />
                                    <Rectangle Width="74" Height="1" Fill="#5A00E5FF" VerticalAlignment="Center" />
                                    <TextBlock Text="DGN-CAL / 09" FontFamily="{StaticResource OrbitronFont}" FontSize="7" CharacterSpacing="70" Foreground="#677F929B" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="◈" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="12" Foreground="#7F00E5FF" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <Button Style="{StaticResource AlienCalendarNavStyle}" Content="◁" HorizontalAlignment="Left" Click="PreviousMonth_Click" AutomationProperties.Name="Previous month" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="MonthTitle" FontFamily="{StaticResource OrbitronFont}" FontSize="15" FontWeight="SemiBold" CharacterSpacing="70" Foreground="#F1F7FCFF" HorizontalAlignment="Center" />
                                <TextBlock Text="ORBITAL MONTH INDEX" FontFamily="{StaticResource OrbitronFont}" FontSize="7" CharacterSpacing="125" Foreground="#6578909C" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Button Style="{StaticResource AlienCalendarNavStyle}" Content="▷" HorizontalAlignment="Right" Click="NextMonth_Click" AutomationProperties.Name="Next month" />
                        </Grid>

                        <Grid Grid.Row="2" ColumnSpacing="2">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Text="SU" Grid.Column="0" /><TextBlock Text="MO" Grid.Column="1" /><TextBlock Text="TU" Grid.Column="2" /><TextBlock Text="WE" Grid.Column="3" /><TextBlock Text="TH" Grid.Column="4" /><TextBlock Text="FR" Grid.Column="5" /><TextBlock Text="SA" Grid.Column="6" />
                            <Grid.Resources><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" /><Setter Property="FontSize" Value="7" /><Setter Property="CharacterSpacing" Value="80" /><Setter Property="Foreground" Value="#8DA9BCC4" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /></Style></Grid.Resources>
                        </Grid>

                        <ItemsControl Grid.Row="3" ItemsSource="{x:Bind Days, Mode=OneWay}" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="7" ItemWidth="43" ItemHeight="40" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="controls:AlienCalendarDay">
                                    <Button Style="{StaticResource AlienCalendarDayStyle}" Content="{x:Bind Label}" Tag="{x:Bind Date}" Click="DayCell_Click"
                                            Background="{x:Bind Background}" BorderBrush="{x:Bind BorderBrush}" Foreground="{x:Bind Foreground}"
                                            Opacity="{x:Bind Opacity}" AutomationProperties.Name="{x:Bind AccessibleLabel}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Grid.Row="4" Margin="2,5,2,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SELECTED COORDINATE" FontFamily="{StaticResource OrbitronFont}" FontSize="7" CharacterSpacing="100" Foreground="#767F929B" />
                                <TextBlock x:Name="SelectedCoordinateText" FontFamily="{StaticResource OrbitronFont}" FontSize="9" CharacterSpacing="60" Foreground="#D900E5FF" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AlienCalendarNavStyle}" Width="66" Content="TODAY" FontSize="7" Click="Today_Click" />
                        </Grid>
                    </Grid>
                </Grid>
            </Flyout>
        </Button.Flyout>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <TextBlock Text="T//" FontFamily="{StaticResource OrbitronFont}" FontSize="7" CharacterSpacing="30" Foreground="#8F00E5FF" />
                <TextBlock x:Name="DateText" Text="SELECT DATE" FontFamily="{StaticResource OrbitronFont}" FontSize="9" CharacterSpacing="55" Foreground="#F3F9FCFF" />
            </StackPanel>
            <Grid Grid.Column="1" Width="21" Height="21" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse Stroke="#8500E5FF" StrokeThickness="1" />
                <Path Data="M 10.5,3 L 10.5,18 M 3,10.5 L 18,10.5" Stroke="#B500E5FF" StrokeThickness="1" />
                <Ellipse Width="4" Height="4" Fill="#FF00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Button>
</UserControl>
