<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nexus.App.Controls.AlienFormChrome"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">
    <Grid>
        <Path Data="M 14,0 L 91,0 L 100,9 L 100,91 L 91,100 L 9,100 L 0,91 L 0,14 Z"
              Stretch="Fill" Fill="{StaticResource HudSheetBrush}" />

        <!-- Broken traces deliberately avoid a conventional panel outline. -->
        <Path Data="M 0,34 L 0,9 L 9,0 L 128,0 L 143,15 L 208,15"
              Stroke="#BB00E5FF" StrokeThickness="1.15" HorizontalAlignment="Left" VerticalAlignment="Top"
              Width="210" Height="35" Stretch="Fill" />
        <Path Data="M 0,0 L 54,0 L 71,17 L 71,84"
              Stroke="#6800E5FF" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top"
              Width="72" Height="86" Stretch="Fill" />
        <Path Data="M 0,48 L 0,18 L 18,0 M 0,34 L 38,34 L 54,48 L 154,48"
              Stroke="#6900E5FF" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
              Width="156" Height="50" Stretch="Fill" />
        <Path Data="M 0,24 L 92,24 L 116,0 L 180,0"
              Stroke="#A300E5FF" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Width="182" Height="26" Stretch="Fill" />

        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,19,21,0" Width="104" Height="16">
            <Rectangle Height="1" Width="80" Fill="#6200E5FF" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <Rectangle Width="18" Height="3" Fill="#C800E5FF" HorizontalAlignment="Right" />
            <Ellipse x:Name="PulseNode" Width="5" Height="5" Fill="#FF00E5FF" HorizontalAlignment="Left" VerticalAlignment="Center" />
        </Grid>

        <Grid HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Width="17" Height="130">
            <Rectangle Width="1" Height="130" Fill="#3000E5FF" HorizontalAlignment="Center" />
            <Rectangle Width="6" Height="26" Fill="#8A00E5FF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0" />
            <Rectangle Width="11" Height="1" Fill="#B000E5FF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" />
        </Grid>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,25,11" Spacing="1">
            <TextBlock Text="DGN // SECURE FORM NODE" FontFamily="{StaticResource OrbitronFont}" FontSize="7" CharacterSpacing="95" Foreground="#8200DFF7" />
            <TextBlock Text="LOCAL / REVIEWABLE / REV-09" FontFamily="{StaticResource OrbitronFont}" FontSize="7" CharacterSpacing="55" Foreground="#5378909C" />
        </StackPanel>

        <Canvas HorizontalAlignment="Center" VerticalAlignment="Center" Width="180" Height="180" Opacity="0.18">
            <Ellipse Width="180" Height="180" Stroke="#4400E5FF" StrokeThickness="1" />
            <Ellipse Width="116" Height="116" Canvas.Left="32" Canvas.Top="32" Stroke="#3800E5FF" StrokeThickness="1" StrokeDashArray="2,7" />
            <Path Data="M 90,8 L 102,20 L 90,32 L 78,20 Z M 90,148 L 102,160 L 90,172 L 78,160 Z"
                  Stroke="#5500E5FF" StrokeThickness="1" />
            <Line X1="24" Y1="90" X2="156" Y2="90" Stroke="#2600E5FF" StrokeThickness="1" />
        </Canvas>
    </Grid>
</UserControl>
