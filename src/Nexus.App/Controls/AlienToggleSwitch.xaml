<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nexus.App.Controls.AlienToggleSwitch"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinHeight="52" Width="310" HorizontalAlignment="Left">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="30" /></Grid.RowDefinitions>
        <TextBlock Text="{Binding Header, ElementName=Root}" FontFamily="{StaticResource OrbitronFont}"
                   FontSize="9.5" CharacterSpacing="35" Foreground="#E8F4FAFC" Margin="0,0,0,5" />

        <Button x:Name="ToggleHit" Grid.Row="1" Width="310" Height="30" MinWidth="0" MinHeight="0"
                AutomationProperties.Name="{Binding Header, ElementName=Root}"
                HorizontalAlignment="Left" Padding="0" Background="Transparent" BorderThickness="0"
                UseSystemFocusVisuals="False" Click="ToggleHit_Click"
                PointerEntered="ToggleHit_PointerEntered" PointerExited="ToggleHit_PointerExited">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Grid>
                </ControlTemplate>
            </Button.Template>
            <Grid Width="310" Height="30" HorizontalAlignment="Left">
                <Grid x:Name="SwitchGlyph" Width="66" Height="27" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><CompositeTransform x:Name="SwitchHoverTransform" /></Grid.RenderTransform>
                    <Path x:Name="TrackGlow" Data="M 8,1 L 56,1 L 65,10 L 65,18 L 56,27 L 8,27 L 1,20 L 1,8 Z"
                          Stretch="Fill" Fill="#2500E5D0" Margin="-3" Opacity="0" />
                    <Path x:Name="TrackBase" Data="M 8,1 L 56,1 L 65,10 L 65,18 L 56,27 L 8,27 L 1,20 L 1,8 Z"
                          Stretch="Fill" Fill="#B20B151D" Stroke="#8C819AA4" StrokeThickness="1.1" />
                    <Path x:Name="ActiveTrack" Data="M 8,4 L 54,4 L 62,11 L 62,17 L 54,24 L 8,24 L 4,19 L 4,9 Z"
                          Stretch="Fill" Fill="#5800CFC2" Stroke="#B000E5FF" StrokeThickness="0.8" Opacity="0" />
                    <Path Data="M 7,7 L 7,20 M 59,9 L 59,18" Stroke="#6200E5FF" StrokeThickness="1" />
                    <Grid x:Name="Actuator" Width="20" Height="20" HorizontalAlignment="Left" Margin="4,0,0,0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><CompositeTransform x:Name="ActuatorTransform" /></Grid.RenderTransform>
                        <Path Data="M 10,0 L 20,10 L 10,20 L 0,10 Z" Fill="#F0B9C8CE" Stroke="#F4EDF9FC" StrokeThickness="0.8" />
                        <Path Data="M 10,4 L 16,10 L 10,16 L 4,10 Z" Fill="#D10A1820" />
                        <Ellipse x:Name="ActuatorCore" Width="5" Height="5" Fill="#FF718991" />
                    </Grid>
                    <Ellipse x:Name="SignalNode" Width="4" Height="4" Fill="#FF00E5FF"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,5,0" Opacity="0.25" />
                </Grid>

                <Grid Margin="78,0,0,0" Height="28" VerticalAlignment="Top">
                    <Path Data="M 0,4 L 13,4 L 19,10 L 94,10" Stroke="#3000E5FF" StrokeThickness="1" VerticalAlignment="Top" />
                    <TextBlock x:Name="StatusText" Margin="12,5,0,0" FontFamily="{StaticResource OrbitronFont}"
                               FontSize="9" CharacterSpacing="25" Foreground="#C9D8E8ED" Text="OFF" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,3" Spacing="3">
                        <Rectangle x:Name="SignalBarA" Width="12" Height="2" Fill="#3500E5FF" />
                        <Rectangle x:Name="SignalBarB" Width="7" Height="2" Fill="#6500E5FF" />
                        <Rectangle x:Name="SignalBarC" Width="3" Height="2" Fill="#A000E5FF" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Button>
    </Grid>
</UserControl>
