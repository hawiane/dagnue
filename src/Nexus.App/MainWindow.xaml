<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Nexus.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#FF05080D">
        <Grid.Resources>
            <Style x:Key="AlienCaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="43" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B800E5FF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Cell">
                            <Border x:Name="Glow" Background="{TemplateBinding Background}" />
                            <Rectangle x:Name="TopSignal" Height="1" Fill="#C000E5FF" VerticalAlignment="Top" Margin="9,0" Opacity="0.28" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse x:Name="Node" Width="3" Height="3" Fill="#FF00E5FF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,4" Opacity="0.25" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.16" /></VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Glow.Background" Value="#3600DDF2" />
                                            <Setter Target="TopSignal.Opacity" Value="1" />
                                            <Setter Target="Node.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Glow.Background" Value="#6500C5D8" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Cell.Opacity" Value="0.35" /></VisualState.Setters></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarSurface" Background="#D8050B11">
            <Canvas IsHitTestVisible="False">
                <Line X1="0" Y1="31" X2="1900" Y2="31" Stroke="#3200E5FF" StrokeThickness="1" />
                <Rectangle x:Name="TitleSweep" Canvas.Top="30" Width="82" Height="2" Opacity="0.72">
                    <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#0000E5FF" Offset="0" /><GradientStop Color="#E800E5FF" Offset="0.72" /><GradientStop Color="#0000E5FF" Offset="1" /></LinearGradientBrush></Rectangle.Fill>
                    <Rectangle.RenderTransform><TranslateTransform x:Name="TitleSweepTransform" /></Rectangle.RenderTransform>
                </Rectangle>
                <Line X1="18" Y1="8" X2="91" Y2="8" Stroke="#4900E5FF" StrokeThickness="1" />
                <Line X1="91" Y1="8" X2="102" Y2="19" Stroke="#4900E5FF" StrokeThickness="1" />
                <Ellipse Canvas.Left="108" Canvas.Top="17" Width="4" Height="4" Fill="#9A00E5FF" />
            </Canvas>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="◇" FontSize="11" Foreground="#D600E5FF" />
                <TextBlock Text="DAGNUE // COMMAND INTERFACE" FontSize="8" CharacterSpacing="115" Foreground="#747F9AA4" />
            </StackPanel>
            <Grid x:Name="TitleBarDragRegion" Margin="0,0,129,0" Background="Transparent" Canvas.ZIndex="1" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Canvas.ZIndex="2">
                <Button Style="{StaticResource AlienCaptionButtonStyle}" Content="⌁" ToolTipService.ToolTip="Minimize" Click="Minimize_Click" />
                <Button x:Name="MaximizeButton" Style="{StaticResource AlienCaptionButtonStyle}" Content="◇" ToolTipService.ToolTip="Maximize / restore" Click="Maximize_Click" />
                <Button Style="{StaticResource AlienCaptionButtonStyle}" Content="×" Foreground="#D9FF6378" ToolTipService.ToolTip="Exit DAGNUE" Click="Exit_Click" />
            </StackPanel>
        </Grid>

        <Frame x:Name="RootFrame" Grid.Row="1" Opacity="0" />

        <Grid x:Name="BootOverlay" Grid.RowSpan="2" Background="#FF02070C" Canvas.ZIndex="20">
            <Canvas IsHitTestVisible="False" Opacity="0.55">
                <Line X1="0" Y1="92" X2="1900" Y2="92" Stroke="#1800E5FF" StrokeThickness="1" />
                <Line X1="0" Y1="760" X2="1900" Y2="760" Stroke="#1300E5FF" StrokeThickness="1" />
                <Line X1="170" Y1="0" X2="170" Y2="1000" Stroke="#1000E5FF" StrokeThickness="1" />
                <Line X1="1280" Y1="0" X2="1280" Y2="1000" Stroke="#1000E5FF" StrokeThickness="1" />
                <Polyline Points="0,180 120,180 145,205 290,205 318,177 415,177" Stroke="#2900E5FF" StrokeThickness="1" />
                <Polyline Points="1030,710 1150,710 1178,682 1340,682 1362,704 1530,704" Stroke="#2900E5FF" StrokeThickness="1" />
            </Canvas>

            <Grid Width="430" Height="430" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-105,0,0">
                <Ellipse Stroke="#2200E5FF" StrokeThickness="1" />
                <Ellipse Width="382" Height="382" Stroke="#9000E5FF" StrokeThickness="2" StrokeDashArray="2,7">
                    <Ellipse.RenderTransform><RotateTransform x:Name="BootOuterRotation" CenterX="191" CenterY="191" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="324" Height="324" Stroke="#4700E5FF" StrokeThickness="8" StrokeDashArray="1,12">
                    <Ellipse.RenderTransform><RotateTransform x:Name="BootMiddleRotation" CenterX="162" CenterY="162" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="270" Height="270" Stroke="#C000D9ED" StrokeThickness="2" StrokeDashArray="24,5">
                    <Ellipse.RenderTransform><RotateTransform x:Name="BootInnerRotation" CenterX="135" CenterY="135" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="BootCoreGlow" Width="216" Height="216" Fill="#1900E5FF" Stroke="#6A00E5FF" StrokeThickness="1" />
                <Canvas Width="430" Height="430" IsHitTestVisible="False">
                    <Line X1="215" Y1="0" X2="215" Y2="54" Stroke="#9000E5FF" StrokeThickness="1" />
                    <Line X1="215" Y1="376" X2="215" Y2="430" Stroke="#9000E5FF" StrokeThickness="1" />
                    <Line X1="0" Y1="215" X2="54" Y2="215" Stroke="#9000E5FF" StrokeThickness="1" />
                    <Line X1="376" Y1="215" X2="430" Y2="215" Stroke="#9000E5FF" StrokeThickness="1" />
                </Canvas>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                    <TextBlock Text="D A G N U E" FontSize="25" FontWeight="SemiBold" CharacterSpacing="165" Foreground="#F000E5FF" HorizontalAlignment="Center" />
                    <TextBlock Text="ALIEN INTELLIGENCE MATRIX" FontSize="8" CharacterSpacing="115" Foreground="#827D9AA4" HorizontalAlignment="Center" />
                    <TextBlock x:Name="BootPercentText" Text="00%" FontFamily="{StaticResource OrbitronFont}" FontSize="22" Foreground="#E8E9FBFF" HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>

            <StackPanel Width="470" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,410,0,0" Spacing="7">
                <Grid Height="20">
                    <TextBlock x:Name="BootStageText" Text="AWAITING CORE SIGNAL" FontSize="10" CharacterSpacing="145" Foreground="#E800E5FF" />
                    <TextBlock x:Name="BootDetailText" Text="Preparing command environment" FontSize="8" Foreground="#8C8BA0A8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Grid Height="3" Background="#1F16404A">
                    <Rectangle x:Name="BootProgressFill" Width="0" HorizontalAlignment="Left">
                        <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#2600E5FF" Offset="0" /><GradientStop Color="#FF00E5FF" Offset="0.82" /><GradientStop Color="#FFF2FFFF" Offset="1" /></LinearGradientBrush></Rectangle.Fill>
                    </Rectangle>
                </Grid>
                <StackPanel Margin="0,7,0,0" Spacing="3">
                    <TextBlock x:Name="BootLog1" Text="&gt; DAGNUE BOOT PROTOCOL ENGAGED" FontFamily="{StaticResource OrbitronFont}" FontSize="8" Foreground="#807B929B" />
                    <TextBlock x:Name="BootLog2" FontFamily="{StaticResource OrbitronFont}" FontSize="8" Foreground="#687B929B" />
                    <TextBlock x:Name="BootLog3" FontFamily="{StaticResource OrbitronFont}" FontSize="8" Foreground="#507B929B" />
                    <TextBlock x:Name="BootLog4" FontFamily="{StaticResource OrbitronFont}" FontSize="8" Foreground="#387B929B" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="INITIALIZATION IS DIAGNOSTIC · NO SYSTEM CHANGES ARE APPLIED" FontSize="7" CharacterSpacing="95"
                       Foreground="#5578909C" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,32" />
        </Grid>
    </Grid>
</Window>
