<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Nexus.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Nexus.App.Controls">
    <Grid Background="{StaticResource NexusBackgroundBrush}" PointerMoved="Root_PointerMoved">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="*" MinWidth="560" />
            <ColumnDefinition Width="0" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Visibility="Collapsed" BorderBrush="#4014D4E8" BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#EA05090F" Offset="0" />
                    <GradientStop Color="#D508121B" Offset="0.55" />
                    <GradientStop Color="#C6061B24" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Canvas IsHitTestVisible="False">
                    <Line X1="219" Y1="0" X2="219" Y2="1000" Stroke="#2A00E5FF" StrokeThickness="1" />
                    <Line X1="225" Y1="0" X2="225" Y2="1000" Stroke="#1000E5FF" StrokeThickness="1" />
                    <Line X1="18" Y1="118" X2="72" Y2="118" Stroke="#3800E5FF" StrokeThickness="1" />
                    <Line X1="72" Y1="118" X2="87" Y2="133" Stroke="#3800E5FF" StrokeThickness="1" />
                    <Line X1="87" Y1="133" X2="207" Y2="133" Stroke="#1E00E5FF" StrokeThickness="1" />
                    <Line X1="18" Y1="552" X2="56" Y2="552" Stroke="#2600E5FF" StrokeThickness="1" />
                    <Line X1="56" Y1="552" X2="69" Y2="565" Stroke="#2600E5FF" StrokeThickness="1" />
                    <Ellipse x:Name="RailNodeTop" Canvas.Left="216" Canvas.Top="126" Width="7" Height="7" Fill="#FF00E5FF" Opacity="0.55" />
                    <Ellipse x:Name="RailNodeMiddle" Canvas.Left="216" Canvas.Top="348" Width="7" Height="7" Fill="#FF00E5FF" Opacity="0.25" />
                    <Ellipse x:Name="RailNodeBottom" Canvas.Left="216" Canvas.Top="710" Width="7" Height="7" Fill="#FF00E5FF" Opacity="0.4" />
                    <Rectangle x:Name="NavScanLine" Canvas.Left="8" Canvas.Top="92" Width="212" Height="1" Opacity="0.7">
                        <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#0000E5FF" Offset="0" /><GradientStop Color="#CC00E5FF" Offset="0.72" /><GradientStop Color="#0000E5FF" Offset="1" /></LinearGradientBrush></Rectangle.Fill>
                        <Rectangle.RenderTransform><TranslateTransform x:Name="NavScanTransform" /></Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>

                <Grid Margin="18,18,18,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="DAGNUE" FontSize="23" FontWeight="Bold" CharacterSpacing="220" Foreground="{StaticResource NexusCyanBrush}" />
                            <TextBlock Text="// 01" FontSize="8" CharacterSpacing="80" Foreground="#6400E5FF" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </StackPanel>
                        <TextBlock Text="LOCAL COMMAND SPINE" FontSize="8" CharacterSpacing="155" Foreground="{StaticResource NexusMutedBrush}" />
                        <Grid Margin="0,5,0,0" Height="5">
                            <Rectangle Height="1" Fill="#3200E5FF" VerticalAlignment="Center" />
                            <Rectangle Width="42" Height="2" Fill="{StaticResource NexusCyanBrush}" HorizontalAlignment="Left" />
                            <Ellipse Width="5" Height="5" Fill="{StaticResource NexusCyanBrush}" HorizontalAlignment="Left" Margin="47,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,20,0,18">
                        <Border Background="#2600DCEB" BorderBrush="#3914D4E8" BorderThickness="1" CornerRadius="3" Padding="10,8" />
                        <StackPanel Orientation="Horizontal" Spacing="9" Margin="11,0" VerticalAlignment="Center">
                            <Grid Width="11" Height="11">
                                <Ellipse Width="10" Height="10" Stroke="#8900E5FF" StrokeThickness="1" />
                                <Ellipse x:Name="ConnectionDot" Width="5" Height="5" Fill="#FF6B7B85" />
                            </Grid>
                            <TextBlock x:Name="ConnectionLabel" Text="INITIALIZING" FontSize="10" FontWeight="SemiBold" CharacterSpacing="45" />
                        </StackPanel>
                        <TextBlock Text="▸" HorizontalAlignment="Right" Margin="0,0,9,0" Foreground="#7000E5FF" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Row="2" Spacing="8">
                        <Grid Height="112" Margin="2,0,0,13">
                            <Canvas IsHitTestVisible="False">
                                <Line X1="0" Y1="108" X2="175" Y2="108" Stroke="#3E00E5FF" StrokeThickness="1" />
                                <Line X1="0" Y1="108" X2="38" Y2="108" Stroke="#E000E5FF" StrokeThickness="2" />
                                <Line X1="177" Y1="8" X2="177" Y2="86" Stroke="#2500E5FF" StrokeThickness="1" />
                                <Ellipse Canvas.Left="174" Canvas.Top="89" Width="6" Height="6" Fill="#B000E5FF" />
                            </Canvas>
                            <StackPanel Spacing="0">
                                <TextBlock x:Name="SidebarDayText" Text="TUESDAY" FontSize="9" CharacterSpacing="125" Foreground="#A8AFC4CA" />
                                <TextBlock x:Name="SidebarTimeText" Text="00:00" FontFamily="{StaticResource OrbitronFont}" FontSize="35" FontWeight="Bold" CharacterSpacing="-20" Foreground="#F5F8FEFF" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="SidebarDateText" Text="04 AUG 2026" FontFamily="{StaticResource OrbitronFont}" FontSize="8" Foreground="#7800E5FF" />
                                    <TextBlock Text="LOCAL" FontSize="7" CharacterSpacing="90" Foreground="#4E7D98A1" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <StackPanel Visibility="Collapsed" Orientation="Horizontal" Spacing="7" Margin="3,0,0,2">
                            <TextBlock Text="NAVIGATION" FontSize="8" CharacterSpacing="150" Foreground="#9A78909C" />
                            <Rectangle Width="62" Height="1" Fill="#2600E5FF" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="CoreNavButton" Visibility="Collapsed" Style="{StaticResource FuturisticNavButtonStyle}" Tag="core" Click="Navigation_Click">
                            <StackPanel Orientation="Horizontal" Spacing="11"><TextBlock Text="◈" FontSize="15" Foreground="{StaticResource NexusCyanBrush}" /><TextBlock Text="NEURAL CORE" FontSize="11" CharacterSpacing="70" /></StackPanel>
                        </Button>
                        <Button x:Name="ScheduleNavButton" Visibility="Collapsed" Style="{StaticResource FuturisticNavButtonStyle}" Tag="schedule" Click="Navigation_Click">
                            <StackPanel Orientation="Horizontal" Spacing="11"><TextBlock Text="◷" FontSize="15" Foreground="#BA78E8F3" /><TextBlock Text="TASK" FontSize="11" CharacterSpacing="70" /></StackPanel>
                        </Button>
                        <Button x:Name="ActivityNavButton" Visibility="Collapsed" Style="{StaticResource FuturisticNavButtonStyle}" Tag="activity" Click="Navigation_Click">
                            <StackPanel Orientation="Horizontal" Spacing="11"><TextBlock Text="≡" FontSize="15" Foreground="#BA78E8F3" /><TextBlock Text="ACTIVITY" FontSize="11" CharacterSpacing="70" /></StackPanel>
                        </Button>
                        <Button x:Name="MemoryNavButton" Visibility="Collapsed" Style="{StaticResource FuturisticNavButtonStyle}" Tag="memory" Click="Navigation_Click">
                            <StackPanel Orientation="Horizontal" Spacing="11"><TextBlock Text="⌁" FontSize="15" Foreground="#BA78E8F3" /><TextBlock Text="MEMORY" FontSize="11" CharacterSpacing="70" /></StackPanel>
                        </Button>
                        <Button x:Name="SettingsNavButton" Visibility="Collapsed" Style="{StaticResource FuturisticNavButtonStyle}" Tag="settings" Click="Navigation_Click">
                            <StackPanel Orientation="Horizontal" Spacing="11"><TextBlock Text="⚙" FontSize="14" Foreground="#BA78E8F3" /><TextBlock Text="SETTINGS" FontSize="11" CharacterSpacing="70" /></StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal" Spacing="7" Margin="3,21,0,2">
                            <TextBlock Text="QUICK TOOLS" FontSize="8" CharacterSpacing="150" Foreground="#9A78909C" />
                            <Rectangle Width="58" Height="1" Fill="#2600E5FF" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Style="{StaticResource FuturisticToolButtonStyle}" Tag="calculator" Click="LaunchApp_Click"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="＋" Foreground="#9A00E5FF" /><TextBlock Text="CALCULATOR" CharacterSpacing="55" /></StackPanel></Button>
                        <Button Style="{StaticResource FuturisticToolButtonStyle}" Tag="notepad" Click="LaunchApp_Click"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="▤" Foreground="#9A00E5FF" /><TextBlock Text="NOTEPAD" CharacterSpacing="55" /></StackPanel></Button>
                        <Button Style="{StaticResource FuturisticToolButtonStyle}" Tag="settings" Click="LaunchApp_Click"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="⌘" Foreground="#9A00E5FF" /><TextBlock Text="SYSTEM CONTROL" CharacterSpacing="55" /></StackPanel></Button>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,16,0,0" Padding="13,12">
                        <Border Background="#2810AFC0" BorderBrush="#3024D5E6" BorderThickness="1" CornerRadius="3" />
                        <Grid Margin="1"><Grid.ColumnDefinitions><ColumnDefinition Width="3" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Rectangle Fill="{StaticResource NexusCyanBrush}" Opacity="0.58" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="3">
                                <TextBlock Text="PERMISSION BOUNDARY" FontSize="8" CharacterSpacing="105" Foreground="{StaticResource NexusMutedBrush}" />
                                <TextBlock x:Name="PermissionLabel" Text="CONFIRM" FontSize="13" FontWeight="SemiBold" CharacterSpacing="75" Foreground="{StaticResource NexusCyanBrush}" />
                                <TextBlock Text="EMERGENCY  CTRL + SHIFT + ESC" FontSize="8" CharacterSpacing="35" Foreground="#9278909C" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="WorkspaceGrid" Grid.Column="1" Padding="20,0,0,0">
            <Grid.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource AlienActionButtonStyle}" />
                <Style TargetType="TextBox" BasedOn="{StaticResource AlienTextBoxStyle}" />
                <Style TargetType="CalendarDatePicker" BasedOn="{StaticResource AlienDatePickerStyle}" />
                <Style TargetType="TimePicker" BasedOn="{StaticResource AlienTimePickerStyle}" />
                <Style x:Key="CoreModeTabStyle" TargetType="Button">
                    <Setter Property="Width" Value="150" /><Setter Property="Height" Value="44" />
                    <Setter Property="MinWidth" Value="0" /><Setter Property="Padding" Value="12,0" />
                    <Setter Property="Background" Value="#B90A171F" /><Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="#D8EAF6FA" /><Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" />
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                        <Grid x:Name="ModeCell" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><CompositeTransform x:Name="ModeCellTransform" /></Grid.RenderTransform>
                            <Path x:Name="ModeAura" Data="M 0,0 L 132,0 L 150,16 L 150,44 L 18,44 L 0,28 Z"
                                  Stretch="Fill" Fill="#3900E5D0" Margin="-4" Opacity="0" IsHitTestVisible="False" />
                            <Path Data="M 0,0 L 132,0 L 150,16 L 150,44 L 18,44 L 0,28 Z"
                                  Stretch="Fill" Fill="{TemplateBinding Background}" IsHitTestVisible="False" />
                            <Path Data="M 0,0 L 42,0 L 48,7 L 48,37 L 40,44 L 18,44 L 0,28 Z"
                                  Stretch="Fill" Fill="#6E07303A" IsHitTestVisible="False" />
                            <Path Data="M 48,5 L 124,5 L 142,20 L 142,38 L 55,38 L 48,31 Z"
                                  Stretch="Fill" Fill="#4C10232B" IsHitTestVisible="False" />
                            <Rectangle Width="4" Height="18" Fill="#B700D7E9" HorizontalAlignment="Left"
                                       VerticalAlignment="Center" Margin="5,0,0,0" IsHitTestVisible="False" />
                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom" Margin="0,0,9,5" IsHitTestVisible="False">
                                <Rectangle Width="15" Height="2" Fill="#7600E5FF" />
                                <Rectangle Width="7" Height="2" Fill="#C000E5FF" />
                                <Rectangle Width="3" Height="2" Fill="#F000E5FF" />
                            </StackPanel>
                            <Path x:Name="ModeTrace" Data="M 0,28 L 0,0 L 54,0 M 112,0 L 132,0 L 150,16 L 150,31 M 150,44 L 18,44 L 7,33"
                                  Stretch="Fill" Stroke="#8A00E5FF" StrokeThickness="1" IsHitTestVisible="False" />
                            <Rectangle x:Name="ModeBeam" Width="28" Height="2" Fill="#C900E5FF"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,-1,0,0" Opacity="0.55" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <Ellipse x:Name="ModeNode" Width="4" Height="4" Fill="#FF00E5FF"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Opacity="0.42" />
                            <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.18" /></VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver"><VisualState.Setters>
                                    <Setter Target="ModeAura.Opacity" Value="1" /><Setter Target="ModeTrace.Opacity" Value="1" />
                                    <Setter Target="ModeBeam.Opacity" Value="1" /><Setter Target="ModeNode.Opacity" Value="1" />
                                    <Setter Target="ModeCellTransform.ScaleX" Value="1.035" /><Setter Target="ModeCellTransform.ScaleY" Value="1.035" />
                                </VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="ModeCellTransform.ScaleX" Value="0.97" /><Setter Target="ModeCellTransform.ScaleY" Value="0.97" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ModeCell.Opacity" Value="0.3" /></VisualState.Setters></VisualState>
                            </VisualStateGroup></VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate></Setter.Value></Setter>
                </Style>
            </Grid.Resources>
            <Grid x:Name="CorePanel">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid x:Name="ModeTabDock" Grid.RowSpan="4" Width="410" Height="104"
                      HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-20,34,0,0" Canvas.ZIndex="75"
                      Background="Transparent"
                      PointerEntered="ModeTabDock_PointerEntered" PointerExited="ModeTabDock_PointerExited">
                    <Grid.RenderTransform><CompositeTransform x:Name="ModeTabDockTransform" TranslateX="-360" /></Grid.RenderTransform>
                    <Grid IsHitTestVisible="False">
                        <Path Data="M 0,6 L 326,6 L 344,23 L 392,23 L 410,41 L 410,82 L 397,95 L 26,95 L 0,70 Z"
                              Stretch="Fill" Fill="#D0061018" />
                        <Path Data="M 8,20 L 286,20 L 305,35 L 305,82 L 286,92 L 25,92 L 8,70 Z"
                              Stretch="Fill" Fill="#68102028" />
                        <Path Width="76" Height="82" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                              Data="M 0,0 L 49,0 L 76,25 L 76,64 L 59,82 L 12,82 L 0,70 Z"
                              Stretch="Fill" Fill="#77082933" />
                        <Path Width="17" Height="71" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,49,0"
                              Data="M 0,0 L 9,0 L 17,10 L 17,61 L 8,71 L 0,71 L 7,59 L 7,12 Z"
                              Stretch="Fill" Fill="#4E00D7E8" />
                        <Path Data="M 0,6 L 326,6 L 344,23 L 392,23 L 410,41 M 410,67 L 410,82 L 397,95 L 260,95 M 205,95 L 26,95 L 0,70"
                              Stretch="Fill" Stroke="#7600E5FF" StrokeThickness="1" />
                        <Path Data="M 0,14 L 294,14 L 309,28 M 88,87 L 224,87 M 337,31 L 386,31"
                              Stretch="Fill" Stroke="#2D00E5FF" StrokeThickness="1" />
                        <Rectangle x:Name="ModeRailScan" Width="74" Height="2" Fill="#C800E5FF"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,5,0,0" Opacity="0.55" />
                    </Grid>

                    <StackPanel x:Name="ModeTabElements" Orientation="Horizontal" Spacing="10"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,31,0,0" Opacity="0">
                        <StackPanel.RenderTransform><CompositeTransform x:Name="ModeTabElementsTransform" TranslateX="-24" /></StackPanel.RenderTransform>
                        <Button x:Name="RadialModeButton" Style="{StaticResource CoreModeTabStyle}" Tag="radial"
                                AutomationProperties.Name="Show radial core status" Click="CoreModeTab_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Grid Width="20" Height="20"><Ellipse Stroke="#C800E5FF" StrokeThickness="1.2" /><Ellipse Width="10" Height="10" Stroke="#7800E5FF" /><Ellipse Width="3" Height="3" Fill="#FF00E5FF" /></Grid>
                                <StackPanel VerticalAlignment="Center" Spacing="1"><TextBlock Text="RADIAL CORE" FontSize="9" FontWeight="SemiBold" CharacterSpacing="70" /><TextBlock Text="STATUS MATRIX" FontSize="7" CharacterSpacing="85" Foreground="#8A88A6B0" /></StackPanel>
                            </StackPanel>
                        </Button>
                        <Button x:Name="MeshModeButton" Style="{StaticResource CoreModeTabStyle}" Tag="mesh"
                                AutomationProperties.Name="Show neural mesh brain" Click="CoreModeTab_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Grid Width="20" Height="20"><Path Data="M 2,11 L 6,4 L 13,2 L 18,8 L 16,16 L 9,18 L 3,15 Z" Stroke="#C800E5FF" StrokeThickness="1" /><Line X1="6" Y1="4" X2="16" Y2="16" Stroke="#6500E5FF" /><Line X1="3" Y1="15" X2="18" Y2="8" Stroke="#6500E5FF" /><Ellipse Width="3" Height="3" Fill="#FF00E5FF" /></Grid>
                                <StackPanel VerticalAlignment="Center" Spacing="1"><TextBlock Text="NEURAL MESH" FontSize="9" FontWeight="SemiBold" CharacterSpacing="70" /><TextBlock Text="BRAIN TOPOLOGY" FontSize="7" CharacterSpacing="85" Foreground="#8A88A6B0" /></StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid x:Name="ModeDockSensor" Width="50" Height="88" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Background="Transparent" PointerEntered="ModeTabDock_PointerEntered">
                        <Path Data="M 0,0 L 32,0 L 46,15 L 46,73 L 32,88 L 0,88 Z" Stroke="#A000E5FF" StrokeThickness="1.1" Fill="#C708151D" IsHitTestVisible="False" />
                        <Path Data="M 13,31 L 24,44 L 13,57 M 21,31 L 32,44 L 21,57" Stroke="#E000E5FF" StrokeThickness="1.2" IsHitTestVisible="False" />
                        <Ellipse Width="5" Height="5" Fill="#E900E5FF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,8,0" IsHitTestVisible="False" />
                        <StackPanel IsHitTestVisible="False" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"><Rectangle Width="3" Height="2" Fill="#4200E5FF" /><Rectangle Width="6" Height="2" Fill="#8500E5FF" /><Rectangle Width="9" Height="2" Fill="#D000E5FF" /></StackPanel>
                        <Button x:Name="ModeDockRevealButton" Width="50" Height="88" MinWidth="0" MinHeight="0"
                                Padding="0" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False"
                                AutomationProperties.Name="Reveal core view tabs" ToolTipService.ToolTip="Core display modes"
                                PointerEntered="ModeTabDock_PointerEntered" Click="ModeDockReveal_Click">
                            <Button.Template><ControlTemplate TargetType="Button"><Grid Background="Transparent" /></ControlTemplate></Button.Template>
                        </Button>
                    </Grid>
                </Grid>
                <StackPanel x:Name="TelemetryStrip" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="18" Margin="0,2,274,0">
                    <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="CPU" FontSize="8" CharacterSpacing="80" Foreground="{StaticResource NexusMutedBrush}" VerticalAlignment="Center" /><TextBlock x:Name="CpuText" Text="--%" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                    <TextBlock Text="·" FontSize="11" Foreground="#445A6A72" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="MEM" FontSize="8" CharacterSpacing="80" Foreground="{StaticResource NexusMutedBrush}" VerticalAlignment="Center" /><TextBlock x:Name="MemoryText" Text="--%" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                    <TextBlock Text="·" FontSize="11" Foreground="#445A6A72" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="DISK" FontSize="8" CharacterSpacing="80" Foreground="{StaticResource NexusMutedBrush}" VerticalAlignment="Center" /><TextBlock x:Name="DiskText" Text="--%" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                    <TextBlock Text="·" FontSize="11" Foreground="#445A6A72" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="TASKS" FontSize="8" CharacterSpacing="80" Foreground="{StaticResource NexusMutedBrush}" VerticalAlignment="Center" /><TextBlock x:Name="TaskText" Text="0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                </StackPanel>
                <Grid x:Name="CoreViewViewport" Grid.Row="0" Grid.RowSpan="4">
                    <Grid x:Name="RadialStatusView" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><CompositeTransform x:Name="RadialStatusTransform" /></Grid.RenderTransform>
                        <controls:NeuralCoreControl x:Name="NeuralCore" Margin="10" />
                        <controls:OrbitalNavigationControl x:Name="OrbitalNavigator" Canvas.ZIndex="20"
                                                           NavigationRequested="OrbitalNavigation_NavigationRequested" />
                        <Grid x:Name="CoreTaskDashboard" Width="305" Height="238" HorizontalAlignment="Right" VerticalAlignment="Top"
                              Margin="0,88,18,0" Canvas.ZIndex="55">
                            <Grid x:Name="CoreTaskDashboardExpandedLayer" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.88,0.12">
                                <Grid.RenderTransform><CompositeTransform x:Name="CoreTaskDashboardExpandedTransform" ScaleX="0.78" ScaleY="0.78" /></Grid.RenderTransform>
                            <Grid IsHitTestVisible="False">
                                <Path Data="M 0,18 L 18,0 L 249,0 L 265,14 L 291,14 L 305,28 L 305,211 L 286,230 L 48,230 L 35,238 L 0,238 Z"
                                      Stretch="Fill" Fill="#E7051118" />
                                <Path Data="M 0,18 L 18,0 L 110,0 M 161,0 L 249,0 L 265,14 L 291,14 L 305,28 L 305,92 M 305,164 L 305,211 L 286,230 L 191,230 M 136,230 L 48,230 L 35,238 L 0,238 L 0,156 M 0,93 L 0,18"
                                      Stretch="Fill" Stroke="#AA00E5FF" StrokeThickness="1" />
                                <Path Data="M 9,29 L 9,18 L 22,7 L 76,7 M 296,40 L 296,78 M 296,185 L 296,207 L 280,222 L 232,222"
                                      Stretch="Fill" Stroke="#5200E5FF" StrokeThickness="1" />
                                <Rectangle Width="74" Height="2" Fill="#D000E5FF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,-1,0,0" />
                                <Ellipse Width="5" Height="5" Fill="#F000E5FF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,12,0" />
                            </Grid>
                            <Grid Margin="15,12,15,14">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="TASK // LIVE OPERATIONS" FontFamily="{StaticResource OrbitronFont}" FontSize="9" CharacterSpacing="75" Foreground="{StaticResource NexusCyanBrush}" />
                                        <TextBlock Text="LOCAL + ONLINE TASK SIGNALS" FontSize="7" CharacterSpacing="45" Foreground="{StaticResource NexusMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
                                        <ProgressRing x:Name="CoreDashboardActivityRing" Width="22" Height="22" IsActive="False" Foreground="{StaticResource NexusCyanBrush}" />
                                        <TextBlock x:Name="CoreDashboardSignalText" Text="SYNCING" FontFamily="{StaticResource OrbitronFont}" FontSize="8" Foreground="{StaticResource NexusCyanBrush}" VerticalAlignment="Center" />
                                        <Button Content="⊖" Width="29" Height="27" MinWidth="0" MinHeight="0" Padding="0"
                                                FontSize="13" Click="CoreTaskDashboardToggle_Click" ToolTipService.ToolTip="Collapse live operations" />
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,10,0,8" ColumnSpacing="4">
