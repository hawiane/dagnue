                    <ControlTemplate TargetType="Button">
                        <Grid Width="64" Height="54" Background="#01000000">
                        <Grid x:Name="AlienReturnGlyph" Width="32" Height="27" RenderTransformOrigin="0.5,0.5"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.RenderTransform><CompositeTransform x:Name="AlienReturnTransform" /></Grid.RenderTransform>
