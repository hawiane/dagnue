                    <Setter Property="Background" Value="#5A10202A" /><Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="#DDF5FBFD" /><Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" /><Setter Property="FontSize" Value="8" />
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                        <Grid x:Name="CommandCell" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><CompositeTransform x:Name="CommandTransform" /></Grid.RenderTransform>
                            <Path Data="M 7,0 L 92,0 L 100,7 L 100,24 L 93,31 L 7,31 L 0,24 L 0,7 Z" Stretch="Fill" Fill="{TemplateBinding Background}" />
                            <Path x:Name="CommandTrace" Data="M 0,23 L 0,8 L 8,0 L 28,0 M 74,31 L 93,31 L 100,24" Stretch="Fill" Stroke="#9200E5FF" StrokeThickness="1" Opacity="0.42" />
