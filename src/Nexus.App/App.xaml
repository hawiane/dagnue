<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Nexus.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="NexusBackground">#FF05080D</Color>
            <Color x:Key="NexusPanel">#E60B131B</Color>
            <Color x:Key="NexusCyan">#FF00E5FF</Color>
            <Color x:Key="NexusTeal">#FF00BFA6</Color>
            <SolidColorBrush x:Key="NexusBackgroundBrush" Color="{StaticResource NexusBackground}" />
            <SolidColorBrush x:Key="NexusPanelBrush" Color="{StaticResource NexusPanel}" />
            <SolidColorBrush x:Key="NexusCyanBrush" Color="{StaticResource NexusCyan}" />
            <SolidColorBrush x:Key="NexusMutedBrush" Color="#FF78909C" />
            <FontFamily x:Key="OrbitronFont">ms-appx:///Assets/Fonts/Orbitron-Medium.ttf#Orbitron Medium</FontFamily>
            <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" /></Style>
            <Style TargetType="Button"><Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" /></Style>
            <Style TargetType="TextBox"><Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" /></Style>
            <Style TargetType="PasswordBox"><Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" /></Style>
            <Style TargetType="ComboBox"><Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" /></Style>
            <Style TargetType="ComboBoxItem"><Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" /></Style>
            <Style TargetType="ToggleSwitch"><Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" /></Style>
            <Style TargetType="CheckBox"><Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" /></Style>
            <Style TargetType="RadioButton"><Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" /></Style>
            <Style TargetType="CalendarDatePicker"><Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" /></Style>
            <Style TargetType="TimePicker"><Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" /></Style>
            <LinearGradientBrush x:Key="HudSheetBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E8050B11" Offset="0" />
                <GradientStop Color="#D80A1821" Offset="0.66" />
                <GradientStop Color="#C705202A" Offset="1" />
            </LinearGradientBrush>
            <Style x:Key="PanelBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="#30101B24" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="FuturisticNavButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="43" />
                <Setter Property="Padding" Value="13,0" />
                <Setter Property="Background" Value="#33121D27" />
                <Setter Property="BorderBrush" Value="#2219CFE2" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#DDECF9FC" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Cell" Height="{TemplateBinding Height}" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><CompositeTransform x:Name="CellTransform" /></Grid.RenderTransform>
                                <Border x:Name="BasePlate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" />
                                <Border x:Name="HoverGlow" Background="#3000E5FF" CornerRadius="3" Opacity="0" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions>
                                    <Border x:Name="EdgeSignal" Width="2" Height="23" HorizontalAlignment="Left" Background="{StaticResource NexusCyanBrush}" Opacity="0.18" />
                                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="9,0,0,0" />
                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="VectorMark" Text="›" FontSize="17" Foreground="{StaticResource NexusCyanBrush}" Opacity="0.18" HorizontalAlignment="Center" />
                                        <Ellipse x:Name="SignalNode" Width="4" Height="4" Fill="{StaticResource NexusCyanBrush}" Opacity="0" HorizontalAlignment="Right" Margin="0,0,1,0" />
                                    </Grid>
                                </Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.18" />
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="HoverGlow.Opacity" Value="0.9" />
                                                <Setter Target="EdgeSignal.Opacity" Value="1" />
                                                <Setter Target="VectorMark.Opacity" Value="0.95" />
                                                <Setter Target="SignalNode.Opacity" Value="1" />
                                                <Setter Target="CellTransform.TranslateX" Value="4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="HoverGlow.Opacity" Value="1" />
                                                <Setter Target="EdgeSignal.Opacity" Value="1" />
                                                <Setter Target="CellTransform.ScaleX" Value="0.985" />
                                                <Setter Target="CellTransform.ScaleY" Value="0.985" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Cell.Opacity" Value="0.35" /></VisualState.Setters></VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="FuturisticToolButtonStyle" TargetType="Button" BasedOn="{StaticResource FuturisticNavButtonStyle}">
                <Setter Property="Height" Value="36" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Background" Value="#20101A23" />
                <Setter Property="BorderBrush" Value="#1819CFE2" />
                <Setter Property="Foreground" Value="#AFC7D9DE" />
                <Setter Property="Opacity" Value="0.82" />
            </Style>
            <Style x:Key="AlienActionButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="38" />
                <Setter Property="MinWidth" Value="104" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="Background" Value="#B014222C" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#E9F7FBFC" />
                <Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="CharacterSpacing" Value="65" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="ActionCell" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><CompositeTransform x:Name="ActionTransform" /></Grid.RenderTransform>
                                <Path Data="M 9,0 L 92,0 L 100,8 L 100,27 L 91,36 L 9,36 L 0,27 L 0,9 Z"
                                      Stretch="Fill" Fill="{TemplateBinding Background}" />
                                <Path x:Name="ActionGlow" Data="M 0,27 L 0,9 L 9,0 L 34,0 M 66,36 L 91,36 L 100,27"
                                      Stretch="Fill" Stroke="#EF00E5FF" StrokeThickness="1.2" Opacity="0.42" />
                                <Path Data="M 6,23 L 6,12 L 11,7" Stroke="#7800E5FF" StrokeThickness="1" />
                                <Path Data="M 89,29 L 95,23 L 95,16" Stroke="#7800E5FF" StrokeThickness="1" HorizontalAlignment="Right" Width="12" Margin="0,0,4,0" Stretch="Fill" />
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,8,0">
                                    <Ellipse x:Name="ActionNode" Width="4" Height="4" Fill="#FF00E5FF" Opacity="0.35" />
                                    <Ellipse Width="9" Height="9" Stroke="#5200E5FF" StrokeThickness="1" />
                                </Grid>
                                <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.15" /></VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="ActionGlow.Opacity" Value="1" /><Setter Target="ActionNode.Opacity" Value="1" /><Setter Target="ActionTransform.ScaleX" Value="1.025" /><Setter Target="ActionTransform.ScaleY" Value="1.025" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="ActionTransform.ScaleX" Value="0.97" /><Setter Target="ActionTransform.ScaleY" Value="0.97" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ActionCell.Opacity" Value="0.32" /></VisualState.Setters></VisualState>
                                </VisualStateGroup></VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="HudSheetStyle" TargetType="Grid">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="58,30,30,28" />
                <Setter Property="Margin" Value="34" />
                <Setter Property="MaxWidth" Value="760" />
                <Setter Property="MaxHeight" Value="680" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Canvas.ZIndex" Value="30" />
            </Style>
            <Style x:Key="AlienTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="#A914202A" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Foreground" Value="#EEF7FCFF" />
                <Setter Property="PlaceholderForeground" Value="#8B8DA2AC" />
                <Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Padding" Value="13,8" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
            </Style>
            <Style x:Key="AlienDatePickerStyle" TargetType="CalendarDatePicker">
                <Setter Property="Background" Value="#A914202A" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="MinHeight" Value="38" />
            </Style>
            <Style x:Key="AlienTimePickerStyle" TargetType="TimePicker">
                <Setter Property="Background" Value="#A914202A" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="FontFamily" Value="{StaticResource OrbitronFont}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="MinHeight" Value="38" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
